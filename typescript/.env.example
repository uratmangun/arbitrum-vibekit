# The MCP endpoint for Ember API. For local development, you can use http://localhost:50051/mcp
EMBER_ENDPOINT=https://api.emberai.xyz/mcp

# EVM RPC URL
RPC_URL=https://arbitrum.llamarpc.com

# QuickNode RPC Endpoint Configuration
# Subdomain for your QuickNode endpoint (e.g., omniscient-capable-wave)
QUICKNODE_SUBDOMAIN="your_quicknode_subdomain_here"
QUICKNODE_API_KEY="your_quicknode_api_key_here"

# Enable token caching to improve startup performance
AGENT_CACHE_TOKENS=false

# Timeout in milliseconds for calls to the MCP server (e.g., getCapabilities)
# Defaults to 30000 (30 seconds) if not set
# MCP_TOOL_TIMEOUT_MS=90000

# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Get your xAI API Key here for chat and image models: https://console.x.ai/
XAI_API_KEY=****

# Get your Groq API Key here for reasoning models: https://console.groq.com/keys
GROQ_API_KEY=****

OPENAI_API_KEY=sk-placeholder-key
OPENROUTER_API_KEY=

# Default AI Provider Configuration (fallback when user doesn't configure in UI)
# Provider type: 'openrouter' or 'openai-compatible'
DEFAULT_PROVIDER_TYPE=openrouter
# Default model to use (e.g., google/gemini-2.5-pro-preview for OpenRouter, or gpt-4o-mini for OpenAI)
DEFAULT_MODEL=google/gemini-2.5-pro-preview
# For OpenAI-compatible providers, set the base URL (leave empty for OpenRouter)
DEFAULT_API_BASE_URL=
# Default API key (uses OPENROUTER_API_KEY if not set and provider is OpenRouter)
DEFAULT_API_KEY=

# Optional: Override the default system prompt for the AI assistant
# Leave empty to use the default DeFi assistant prompt
DEFAULT_SYSTEM_PROMPT=

MNEMONIC=""

ALLORA_API_KEY=
NEXT_PUBLIC_PARA_API_KEY=
PARA_API_KEY=
# MCP Server Configuration (backend-only)
# Supports multiple servers via numbered pattern: MCP_SERVER_1_ID, MCP_SERVER_1_URL, etc.
# Or use single server: MCP_SERVER_ID, MCP_SERVER_URL
# Example for multiple servers:
# MCP_SERVER_1_ID=para-mcp-server
# MCP_SERVER_1_URL=https://para-mcp-server.vercel.app/mcp
# MCP_SERVER_2_ID=another-mcp-server
# MCP_SERVER_2_URL=https://another-mcp-server.example.com/mcp
# Example for single server:
# MCP_SERVER_ID=para-mcp-server
# MCP_SERVER_URL=https://para-mcp-server.vercel.app/mcp
