# DeFi Safety Agent Environment Configuration
# Copy this file to .env and fill in your values

# AI Provider API Keys (at least one required)
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Agent Configuration
AGENT_NAME=
AGENT_VERSION=
AGENT_DESCRIPTION=

# Server Configuration  
PORT=
ENABLE_CORS=

# LLM Model Configuration
# Available models: google/gemini-flash-1.5, openai/gpt-4o-mini, anthropic/claude-3-haiku, etc.
LLM_MODEL=

# Optional: Base path for API routes
# BASE_PATH=/api/v1
