# Server configuration
PORT=

# A2A configuration
# Note: Agent URL is configured in config/agent.md (card.url field)
A2A_SERVER_LOGGING=

# AI provider configuration
AI_PROVIDER=

# AI provider API keys (configure the provider you're using)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
HYPERBOLIC_API_KEY=

# Tool configuration
AGENT_TOOL_TIMEOUT_MS=

# Wallet configuration (optional)
TEST_PRIVATE_KEY=
RPC_URL=

# Workflow configuration
# Set to 'true' to skip actual blockchain transactions in workflows (uses mock receipts)
# Useful for testing workflow flows without spending gas or requiring funded wallets
DEBUG_MODE=

# Logging configuration
LOG_LEVEL=
LOG_STRUCTURED=

# x402 Payment configuration
X402_FACILITATOR_URL=
